config.stopBubbling = true

# Sin esto, @RequiredArgsConstructor genera el constructor pero NO copia las anotaciones
# @Qualifier de los campos hacia los parámetros del constructor — el campo queda anotado,
# pero Spring construye el bean leyendo las anotaciones del PARÁMETRO, no del campo. El
# resultado observable sin esta línea: la ambigüedad entre los 3 beans de tipo
# AgenteDelComite (agenteEvaluador/agentePsicopedagogo/agenteAdaptacion, ver
# AiServicesConfig) se resolvería solo por una coincidencia de nombre entre el parámetro y
# el bean — un mecanismo real de Spring, pero implícito y frágil ante un renombrado futuro.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
