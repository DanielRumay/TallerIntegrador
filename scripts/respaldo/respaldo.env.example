# Copiar a /etc/semantika/respaldo.env (chmod 600). Este archivo lleva secretos: no se versiona.

RESPALDO_DIR=/var/backups/semantika

# Frase de cifrado, en un archivo con permisos 600. Guarda otra copia FUERA del servidor:
# sin ella, ningun respaldo se puede abrir.
CLAVE_ARCHIVO=/etc/semantika/respaldo.clave

PG_CONTENEDOR=taller-postgres-db
PG_USUARIO=postgres
PG_BASE=colegio_db

MONGO_CONTENEDOR=taller-mongo-db
MONGO_BASE=colegio_mongo
# Se usa dentro del contenedor, por eso el host es localhost. Va entre comillas simples.
MONGO_URI='mongodb://<USUARIO>:<CLAVE>@localhost:27017/colegio_mongo?authSource=admin'

QDRANT_CONTENEDOR=taller-qdrant
QDRANT_API_KEY='<CLAVE_QDRANT>'

RETENCION_DIAS=30
RETENCION_MENSUAL_DIAS=730

# Opcional: remoto de rclone para la copia fuera del servidor (por ejemplo, gdrive:semantika).
RCLONE_DESTINO=
